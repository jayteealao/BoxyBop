# BoxyBop Environment Variables
# Copy this to .env and fill in your values

# Required: Replicate API token for OmniParser
# Get your token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: Gemini API key for UI element analysis
# GEMINI_API_KEY=

# Optional: Anthropic API key for Claude Agent SDK code generation
# ANTHROPIC_API_KEY=

# Server port (default: 3001)
# PORT=3001

# Environment (development | production | test)
# NODE_ENV=development

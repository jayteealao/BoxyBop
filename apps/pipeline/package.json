{
  "name": "@boxybop/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:parse": "node --import tsx --test test/parse.test.ts",
    "test:style-guardrail": "node --import tsx --test test/style-guardrail.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@boxybop/ir": "workspace:*",
    "@boxybop/registry": "workspace:*",
    "@boxybop/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "replicate": "^0.25.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
